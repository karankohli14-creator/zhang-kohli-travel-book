# Never commit real values. Add them in Vercel Project Settings → Environment Variables.
ELEVENLABS_API_KEY=replace-with-your-private-api-key
ELEVENLABS_VOICE_ID=replace-with-your-voice-id
KMATE_VOICE_ACCESS_KEY=replace-with-a-long-random-private-code

# Browser origins only; do not include URL paths.
KMATE_ALLOWED_ORIGINS=https://karankohli14-creator.github.io,http://localhost:4173,http://127.0.0.1:4173

# Optional model and service tuning.
ELEVENLABS_LOW_LATENCY_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_QUALITY_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
KMATE_VOICE_REQUESTS_PER_MINUTE=12
